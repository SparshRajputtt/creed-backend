########################################
# Database
########################################
MONGODB_URI=mongodb://localhost:27017/creed-ecommerce
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster0.abcd.mongodb.net/creed-ecommerce


########################################
# JWT (Authentication)
########################################
JWT_SECRET=sample_jwt_secret_key_123456789
JWT_EXPIRE=7d

JWT_REFRESH_SECRET=sample_jwt_refresh_secret_key_987654321
JWT_REFRESH_EXPIRE=30d


########################################
# Email Service (Gmail SMTP)
########################################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=example@gmail.com
SMTP_PASSWORD=your_app_password_here
# Note: Use Gmail App Password, not Gmail login password.


########################################
# Cloudinary (File Uploads)
########################################
CLOUDINARY_CLOUD_NAME=sample_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=samplecloudinarysecret987654321


########################################
# Frontend URLs
########################################
CORS_ORIGIN=http://localhost:3000
RESET_PASSWORD_DOMAIN=http://localhost:3000


########################################
# Server
########################################
PORT=4000
NODE_ENV=development
# Change to production when deploying:
# NODE_ENV=production


########################################
# Razorpay (Payment Gateway)
########################################
RAZORPAY_KEY_ID=rzp_test_ABCDEFGHIJKLMNOP
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key_123456


#############################
#Open Router API key for chatbot
##############################

OPENROUTER_API_KEY=*********************************